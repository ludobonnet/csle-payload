# --- Base de données ---
# Dev : Postgres 17 local (docker run … postgres:17, port 55433)
DATABASE_URL=postgresql://csle:csle@127.0.0.1:55433/csle
# Taille du pool (serveur Postgres partagé en prod : rester sobre)
DATABASE_POOL_MAX=5

# Chiffrement des JWT Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# URL publique du site, sans slash final (CORS, liens, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# Authentifie le déclenchement des jobs Payload hors session
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Valide les requêtes de prévisualisation
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- Médias sur Cloudflare R2 (laisser vide en dev : stockage disque public/media) ---
# Endpoint du compte : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Jeton dédié au bucket des médias (lecture/écriture sur ce seul bucket)
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=csle-media
# Domaine public du bucket, sans slash final
MEDIA_PUBLIC_BASE_URL=https://images.csle.fr
