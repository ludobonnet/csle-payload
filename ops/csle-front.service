# /etc/systemd/system/csle-front.service — csle.fr (Next standalone + Payload)
# Modèle : runbook LSAN §5.3. Exposé uniquement en loopback, via le tunnel Cloudflare.
[Unit]
Description=csle.fr (Next standalone + Payload)
After=network.target postgresql.service
Wants=postgresql.service
# Base momentanément injoignable : réessayer sans fin plutôt que rester en « failed »
StartLimitIntervalSec=0

[Service]
User=csle-front
Group=csle-front
WorkingDirectory=/srv/csle/front/current
EnvironmentFile=/etc/csle/front.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
TimeoutStopSec=30

# --- Durcissement (isolation « type conteneur » sans Docker) ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/csle/front/cache
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
