# /etc/csle/front.env — 640 root:csle-front. Ne jamais committer de valeurs réelles.
NODE_ENV=production
PORT=3005
# Sans HOSTNAME, le standalone écoute sur 0.0.0.0 : loopback uniquement, le tunnel fait le reste
HOSTNAME=127.0.0.1

# Rôle propriétaire de la base csle uniquement (migrations appliquées au démarrage)
DATABASE_URL=postgresql://csle:__MOT_DE_PASSE__@127.0.0.1:5432/csle
DATABASE_POOL_MAX=5

PAYLOAD_SECRET=__openssl_rand_base64_32__
CRON_SECRET=__openssl_rand_base64_32__
PREVIEW_SECRET=__openssl_rand_base64_32__

# Déjà figées dans le bundle au build, reprises ici pour le code serveur
NEXT_PUBLIC_SERVER_URL=https://csle.fr
MEDIA_PUBLIC_BASE_URL=https://images.csle.fr

# Bucket R2 des médias : jeton dédié, limité à ce bucket
R2_ENDPOINT=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=csle-media
